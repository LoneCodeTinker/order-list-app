#!/bin/bash
# This script sets up SSL certificates and runs the Order List App using config from .env

set -e

# Load .env variables
if [ -f .env ]; then
  export $(grep -v '^#' .env | xargs)
else
  echo ".env file not found!"
  exit 1
fi

# Generate SSL certificates using mkcert and SERVER_NAMES from .env
if [ -z "$SERVER_NAMES" ]; then
  echo "SERVER_NAMES not set in .env!"
  exit 1
fi

mkdir -p /etc/nginx/ssl
mkcert -install
mkcert -cert-file /etc/nginx/ssl/orderapp.local.pem -key-file /etc/nginx/ssl/orderapp.local-key.pem $SERVER_NAMES

echo "SSL certificates generated for: $SERVER_NAMES"

echo "Ready to start backend and frontend using config from .env"
# Example: npm run start:all or your preferred start command

# install nginx reverse proxy server to manage our requests
apt install nginx
ufw allow 'Nginx Full'

ufw allow 21

# install npm
apt install npm

# install python venv
apt install Python3-venv

# Clone the app from GitHub
git clone https://github.com/LoneCodeTinker/order-list-app.git ~/orderapp

# go to the dir
cd ~/orderapp/

# get the nginx config
cp nginxConfig /etc/nginx/sites-available/orderapp
# link the enabled site
ln /etc/nginx/sites-available/orderapp /etc/nginx/sites-enabled/ 

# verify config and restart nginx to apply the changes
nginx -t
systemctl restart nginx

# the following command creates the virtual environment for installing pip requirements.. un-comment as necessary, for example: if you get 'error: externally-managed-environment'
# Python3 -m venv venv

# Deploy and run the app
npm install
npm run build
npm install -g pm2
pm2 start npm --name "orderapp" -- run start:prod
pm2 save
pm2 startup
# if you want to run the app in development mode, use the following command instead
# npm run start:all
